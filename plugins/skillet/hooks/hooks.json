{
  "description": "Skillet hooks: guard against editing or committing on the primary checkout and flag overly verbose comments (PreToolUse), and record each worktree's work-in-progress status to .claude/status/STATUS.md (Stop)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-main-checkout.sh",
            "statusMessage": "Checking this is a worktree, not the main checkout"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-commit-on-main.sh",
            "statusMessage": "Checking the commit isn't landing on main"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-verbose-comments.sh",
            "statusMessage": "Checking for overly verbose comments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/worktree-status.sh\""
          }
        ]
      }
    ]
  }
}
